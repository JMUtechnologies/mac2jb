#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) readonly buffer Controls {uint raw[];} c;
layout(set=0,binding=1,std430) coherent buffer Media {uint m[];} media;
bool validSize(uint width,uint height) {
    return (width==320u && height==180u) || (width==640u && height==360u) ||
        (width==960u && height==540u) || (width==1280u && height==720u) ||
        (width==1920u && height==1080u);
}
uint stickDirections(ivec4 sticks,uint previous) {
    // Signed axes/positive-Y-up are established in HBLauncher README "Input"
    // and sdk/include/hb.glsl hbStick. These are media-protocol direction bits;
    // deriving them explicitly also supports native states without pseudo keys.
    // Engage at 55%, release at 40% to keep a held direction stable near its edge.
    uint directions=0u;
    for(uint axis=0u;axis<4u;axis++) {
        uint negativeBit=axis==0u?16u:axis==1u?19u:axis==2u?20u:23u;
        uint positiveBit=axis==0u?18u:axis==1u?17u:axis==2u?22u:21u;
        int negativeThreshold=(previous&(1u<<negativeBit))!=0u?13107:18022;
        int positiveThreshold=(previous&(1u<<positiveBit))!=0u?13107:18022;
        if(sticks[axis]<=-negativeThreshold)directions|=1u<<negativeBit;
        if(sticks[axis]>=positiveThreshold)directions|=1u<<positiveBit;
    }
    return directions;
}
void inputEvent(uint pressed,uint buttons,uint kind,uint x,uint y,uint pressedHigh,uint buttonsHigh) {
    uint next=media.m[34]+1u, base=64u+((next-1u)%48u)*8u;
    media.m[base+1u]=pressed;media.m[base+2u]=buttons;media.m[base+3u]=kind;
    media.m[base+4u]=x;media.m[base+5u]=y;
    media.m[base+6u]=pressedHigh;media.m[base+7u]=buttonsHigh;
    memoryBarrierBuffer();
    media.m[base]=next;
    memoryBarrierBuffer();
    media.m[34]=next;
}
void main() {
    if(media.m[0]!=0x314d5453u || media.m[1]!=4u) return;
    media.m[33]++;
    memoryBarrierBuffer();
    uint commit=media.m[4], slot=commit&3u, sequence=commit>>2u;
    if(sequence!=0u && slot<3u && commit!=media.m[32]) {
        uint base=(4096u+slot*1048576u)/4u;
        if(validSize(media.m[base+2u],media.m[base+3u]) && media.m[base]==sequence) {
            media.m[36]=media.m[base+1u];
            memoryBarrierBuffer();
            media.m[32]=commit;
        }
    }
    bool connected=(c.raw[8]&1u)!=0u;
    uint buttons=connected?c.raw[2]:0u,buttonsHigh=connected?c.raw[3]:0u;
    // Preserve raw right X continuously for proportional host-side seeking.
    int rightStickX=connected?clamp(int(c.raw[6]),-32767,32767):0;
    uint directions=connected?stickDirections(ivec4(c.raw[4],c.raw[5],c.raw[6],c.raw[7]),media.m[43]):0u;
    media.m[43]=directions;buttons|=directions;
    for(uint i=0u;i<4u;i++) {
        uint base=512u+i*16u;
        bool padConnected=(media.m[base+8u]&1u)!=0u;
        int candidate=padConnected?clamp(int(media.m[base+6u]),-32767,32767):0;
        if(abs(candidate)>abs(rightStickX))rightStickX=candidate;
        directions=padConnected?stickDirections(ivec4(media.m[base+4u],media.m[base+5u],media.m[base+6u],media.m[base+7u]),media.m[44u+i]):0u;
        media.m[44u+i]=directions;buttons|=directions;
        if(padConnected){buttons|=media.m[base+2u];buttonsHigh|=media.m[base+3u];}
    }
    uint pressed=buttons&~media.m[38],pressedHigh=buttonsHigh&~media.m[39];
    media.m[38]=buttons;media.m[39]=buttonsHigh;
    media.m[35]=buttons;media.m[37]=buttonsHigh;
    media.m[48]=uint(rightStickX);
    if(pressed!=0u || pressedHigh!=0u)inputEvent(pressed,buttons,1u,0u,0u,pressedHigh,buttonsHigh);
    // Exact GetTouchScreenState<16> ABI used by HBLauncher launcher-loop.cjs:
    // output at controls+128; count +8, first attributes +24, x/y +32/+36.
    // launcher.comp and launcher-desktop-check.cjs establish 1280x720 coordinates.
    uint touchCount=c.raw[34];
    bool touchSample=touchCount>=1u && touchCount<=16u;
    bool ending=touchSample && (c.raw[38]&2u)!=0u;
    bool touching=touchSample && !ending;
    uint touchId=touchSample?c.raw[39]:media.m[50];
    bool previousTouch=media.m[40]!=0u;
    if(previousTouch && (!touching || touchId!=media.m[50])) {
        // An explicit End sample still carries this finger's final position.
        // A missing sample or a replacement finger must retain the old one.
        if(ending && touchId==media.m[50]) {
            media.m[41]=min(c.raw[40],1279u);media.m[42]=min(c.raw[41],719u);
        }
        inputEvent(0u,buttons,4u,media.m[41],media.m[42],0u,buttonsHigh);
        previousTouch=false;
    }
    if(touching) {
        uint x=min(c.raw[40],1279u),y=min(c.raw[41],719u);
        if(!previousTouch)inputEvent(0u,buttons,2u,x,y,0u,buttonsHigh);
        else if(x!=media.m[41] || y!=media.m[42])inputEvent(0u,buttons,3u,x,y,0u,buttonsHigh);
        media.m[41]=x;media.m[42]=y;
        media.m[50]=touchId;
    }
    media.m[40]=touching?1u:0u;
    memoryBarrierBuffer();
    media.m[51]=media.m[33];
}
